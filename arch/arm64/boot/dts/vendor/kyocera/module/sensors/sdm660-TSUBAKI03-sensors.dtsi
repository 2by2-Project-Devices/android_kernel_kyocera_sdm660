#include "sdm630-common-sensors.dtsi"
&soc {
	/delete-node/ sensor_power;
};

&spi_1 {
	status = "ok";
	/delete-node/ sensor_micon;
	qlspi_eoss3@0 {
		compatible = "qlspi,qlspi_eoss3";
		reg = <0>;
		interrupt-parent = <&tlmm>;
		interrupts = <30 0>;
		spi-max-frequency = <19200000>;
		spi-min-frequency = <640000>;
		pinctrl-names = "sensor_micon_default", "sensor_micon_active", "sensor_micon_sleep",
						"sensor_micon_spi_cs_active", "sensor_micon_spi_cs_suspend", "sensor_micon_spi_cs_reset",
						"sensor_micon_rst_active", "sensor_micon_rst_suspend",
						"sensor_micon_vmicon_11_active","sensor_micon_vmicon_11_suspend",
						"sensor_micon_vsensor_18_active","sensor_micon_vsensor_18_suspend",
						"sensor_micon_vmicon_18_active","sensor_micon_vmicon_18_suspend",
						"spi_default", "spi_sleep", "sensor_micon_spi_cs_request";
		pinctrl-0 = <&micon_int_n_default &micon_int_out_default &micon_rst_n_default>;
		pinctrl-1 = <&micon_int_n_active &micon_int_out_active &micon_rst_n_active>;
		pinctrl-2 = <&micon_int_n_suspend &micon_int_out_suspend &micon_rst_n_suspend>;
		pinctrl-3 = <&sensor_micon_spi_cs_active>;
		pinctrl-4 = <&sensor_micon_spi_cs_suspend>;
		pinctrl-5 = <&sensor_micon_spi_cs_reset>;
		pinctrl-6 = <&sensor_micon_rst_active>;
		pinctrl-7 = <&sensor_micon_rst_suspend>;
		pinctrl-8 = <&sensor_micon_vmicon_11_active>;
		pinctrl-9 = <&sensor_micon_vmicon_11_suspend>;
		pinctrl-10 = <&sensor_micon_vsensor_18_active>;
		pinctrl-11 = <&sensor_micon_vsensor_18_suspend>;
/*
		pinctrl-12 = <&sensor_micon_vmicon_18_active>;
		pinctrl-13 = <&sensor_micon_vmicon_18_suspend>;
		pinctrl-14 = <&spi_micon_mosi_active
				 	  &spi_micon_miso_active
				 	  &spi_micon_clk_active>;
		pinctrl-15 = <&spi_micon_mosi_suspend
				 	  &spi_micon_miso_suspend
				 	  &spi_micon_clk_suspend>;
		pinctrl-16 = <&sensor_micon_spi_cs_request>;
*/
		qlspi,rst-gpio = <&tlmm 13 0>;
		qlspi,irq-out-gpio = <&tlmm 12 0>;
		qlspi,irq-gpio = <&tlmm 30 0>;
		qlspi,cs-gpio = <&tlmm 2 0>;
		//qlspi,fabrdy-gpio = <&msm_gpio 7 0>;

		spi-cs-low; /* CS Active Level LOW */
		micon-acc-conv_axis = /bits/ 8 <4>;
		micon-gyro-conv_axis = /bits/ 8 <4>;
		micon-mag-conv_axis = /bits/ 8 <4>;
		micon-mag-static_matrix = <0x258A 0x07BC 0x0082 0x0550 0x2198 0x001E 0x058C 0xFA1A 0x27C4>; /* 9610, 1980, 130, 1360, 8600, 30, 1420, -1510, 10180 */

		vmicon_18-supply = <&pm660_l14>;

		vmicon_11 {
			ctrl = <1>; /* 1:pinctrl, 2:pm ldo, 3:pm gpio*/
			gpio = <&tlmm 73 0>;
		};
		vmicon_18 {
			ctrl = <2>; /* 1:pinctrl, 2:pm ldo, 3:pm gpio*/
			voltage-min = <1800000>;
			voltage-max = <1800000>;
			load = <50000>;
		};
		sens_sleep_clk {
			ctrl = <3>; /* 1:pinctrl, 2:pm ldo, 3:pm gpio*/
			gpio = <&pm660_gpios 2 0>;
		};
		vsensor_18 {
			ctrl = <1>; /* 1:pinctrl, 2:pm ldo, 3:pm gpio*/
			gpio = <&tlmm 77 0>;
		};
	};
};

&i2c_6 {
	status = "ok";
	rpr0521@38 { /* Ambient light and proximity sensor */
		status = "ok";
		chip-vendor {
			type = <0>; /* 0:Qcom, 1:MediaTek */
		};
	};
};

&tlmm {
	/delete-node/ micon_brmp;
	micon_int_out {
		micon_int_out_default: micon_int_out_default {
			mux {
				pins = "gpio12";
				function = "gpio";
			};
			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
				ouput-low;
			};
		};
		micon_int_out_active: micon_int_out_active {
			mux {
				pins = "gpio12";
				function = "gpio";
			};
			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
				ouput-low;
			};
		};
		micon_int_out_suspend: micon_int_out_suspend {
			mux {
				pins = "gpio12";
				function = "gpio";
			};
			config {
				pins = "gpio12";
				drive-strength = <2>;
				bias-disable;
				ouput-low;
			};
		};
	};

	sensor_micon_spi_cs {
		sensor_micon_spi_cs_active: sensor_micon_spi_cs_active {
			mux {
				pins = "gpio2";
				function = "blsp_spi1";
			};
			config {
				pins = "gpio2";
				drive-strength = <2>;
				bias-disable;
				output-high;
			};
		};
		sensor_micon_spi_cs_suspend: sensor_micon_spi_cs_suspend {
			mux {
				pins = "gpio2";
				function = "gpio";
			};
			config {
				pins = "gpio2";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
		sensor_micon_spi_cs_reset: sensor_micon_spi_cs_reset {
			mux {
				pins = "gpio2";
				function = "gpio";
			};
			config {
				pins = "gpio2";
				drive-strength = <2>;
				bias-disable;
				output-high;
			};
		};
	};
	sensor_micon_rst {
		sensor_micon_rst_active: sensor_micon_rst_active {
			mux {
				pins = "gpio13";
				function = "gpio";
			};
			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-disable;
				output-high;
			};
		};
		sensor_micon_rst_suspend: sensor_micon_rst_suspend {
			mux {
				pins = "gpio13";
				function = "gpio";
			};
			config {
				pins = "gpio13";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
	};
	/delete-node/ micon_int_n;
	micon_int_n {
		micon_int_n_default: micon_int_n_default {
			mux {
				pins = "gpio30";
				function = "gpio";
			};
			config {
				pins = "gpio30";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
		micon_int_n_active: micon_int_n_active {
			mux {
				pins = "gpio30";
				function = "gpio";
			};
			config {
				pins = "gpio30";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
		micon_int_n_suspend: micon_int_n_suspend {
			mux {
				pins = "gpio30";
				function = "gpio";
			};
			config {
				pins = "gpio30";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};
	sensor_micon_vmicon_11 {
		sensor_micon_vmicon_11_active: sensor_micon_vmicon_11_active {
			mux {
				pins = "gpio73";
				function = "gpio";
			};
			config {
				pins = "gpio73";
				device-strength = <2>;
				output-high;
				bias-disable;
			};
		};
		sensor_micon_vmicon_11_suspend: sensor_micon_vmicon_11_suspend {
			mux {
				pins = "gpio73";
				function = "gpio";
			};
			config {
				pins = "gpio73";
				device-strength = <2>;
				output-low;
				bias-disable;
			};
		};
	};
	sensor_micon_vsensor_18 {
		sensor_micon_vsensor_18_active: sensor_micon_vsensor_18_active {
			mux {
				pins = "gpio77";
				function = "gpio";
			};
			config {
				pins = "gpio77";
				device-strength = <2>;
				output-high;
				bias-disable;
			};
		};
		sensor_micon_vsensor_18_suspend: sensor_micon_vsensor_18_suspend {
			mux {
				pins = "gpio77";
				function = "gpio";
			};
			config {
				pins = "gpio77";
				device-strength = <2>;
				output-low;
				bias-disable;
			};
		};
	};
	/delete-node/ proximity_int_n;
	proximity_int_n {
		proximity_int_n_default: proximity_int_n_default {
			mux {
				pins = "gpio71";
				function = "gpio";
			};
			config {
				pins = "gpio71";
				drive-strength = <2>;
				bias-disable;
			};
		};
		proximity_int_n_active: proximity_int_n_active {
			mux {
				pins = "gpio71";
				function = "gpio";
			};
			config {
				pins = "gpio71";
				drive-strength = <2>;
				bias-disable;
			};
		};
		proximity_int_n_suspend: proximity_int_n_suspend {
			mux {
				pins = "gpio71";
				function = "gpio";
			};
			config {
				pins = "gpio71";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
	i2s_sck_micon {
		i2s_sck_micon_default: i2s_sck_micon_default {
			mux {
				pins = "gpio24";
				function = "gpio";
			};
			config {
				pins = "gpio24";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
		i2s_sck_micon_active: i2s_sck_micon_active {
			mux {
				pins = "gpio24";
				function = "func3";
			};
			config {
				pins = "gpio24";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
		i2s_sck_micon_suspend: i2s_sck_micon_suspend {
			mux {
				pins = "gpio24";
				function = "func3";
			};
			config {
				pins = "gpio24";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
	};
	i2s_ws_micon {
		i2s_ws_micon_default: i2s_ws_micon_default {
			mux {
				pins = "gpio25";
				function = "gpio";
			};
			config {
				pins = "gpio25";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
		i2s_ws_micon_active: i2s_ws_micon_active {
			mux {
				pins = "gpio25";
				function = "func3";
			};
			config {
				pins = "gpio25";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
		i2s_ws_micon_suspend: i2s_ws_micon_suspend {
			mux {
				pins = "gpio25";
				function = "func3";
			};
			config {
				pins = "gpio25";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
	};
	i2s_data_micon {
		i2s_data_micon_default: i2s_data_micon_default {
			mux {
				pins = "gpio26";
				function = "gpio";
			};
			config {
				pins = "gpio26";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
		i2s_data_micon_active: i2s_data_micon_active {
			mux {
				pins = "gpio26";
				function = "func4";
			};
			config {
				pins = "gpio26";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
		i2s_data_micon_suspend: i2s_data_micon_suspend {
			mux {
				pins = "gpio26";
				function = "func4";
			};
			config {
				pins = "gpio26";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

