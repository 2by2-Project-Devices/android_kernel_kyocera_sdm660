&soc{
    usb3: ssusb@a800000 { /* USB3.0 */
        dwc3@a800000 {
            /delete-property/snps,usb3-u1u2-disable;
        };
    };
};

&spmi_bus {
    qcom,pm660@0 {
        pm660_pdphy: qcom,usb-pdphy@1700 {
            qcom,default-sink-caps = <5000 1900>, /* 5V @ 1.9A */
                                     <9000 1900>; /* 9V @ 1.9A */
        };
    };
};
