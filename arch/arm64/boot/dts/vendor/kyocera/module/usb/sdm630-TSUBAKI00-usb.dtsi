&qusb_phy0 {
	qcom,qusb-phy-init-seq = <0xf8 0x80
				0x40 0x84
				0x83 0x88
				0xC5 0x8c
				0x30 0x08
				0x79 0x0c
				0x21 0x10
				0x14 0x9c
				0x9f 0x1c
				0x00 0x18>;
};

