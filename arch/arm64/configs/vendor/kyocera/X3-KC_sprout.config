# Audio
CONFIG_SND_SOC_TFA98XX=y

# Display
# CONFIG_BACKLIGHT_QCOM_SPMI_WLED is not set
# CONFIG_FB_MSM_MDSS_DP_PANEL is not set
CONFIG_LEDS_OEM=y
CONFIG_LEDS_QPNP_WLED=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_INPUT_FINGERPRINT_FPC=y
CONFIG_INPUT_FINGERPRINT_FPC1020=y

# NFC
CONFIG_NFC=y
CONFIG_NFC_CXD224X=y
CONFIG_NFC_CXD224X_RST=y

# No system-as-root
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Touch
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_DEVICETREE_SUPPORT=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_I2C=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_MT_B=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_DEVICE_ACCESS=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_LOADER=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_BINARY_FW_UPGRADE=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_MANUAL_TTCONFIG_UPGRADE=y
CONFIG_TOUCHSCREEN_CYPRESS_CYTTSP5_BINARY_TTCONFIG_UPGRADE=y
CONFIG_TOUCHSCREEN_KC_SENSOR_SWITCH=y
CONFIG_TOUCHSCREEN_KC_TOUCHMODE_ENABLED=y
CONFIG_TOUCHSCREEN_KC_TOUCHMODE_IOCTL=y

# WLAN
CONFIG_QCA_CLD_WLAN=y
